[Unit]
Description=QueryNZV4 checks board heartbeat — alarms if the board itself has not run (plan step 1.6)

[Service]
Type=oneshot
# the release copy (release-copy-1): one pushed commit of origin/main, moved only by `python -m support.installer release`
WorkingDirectory=/home/user/querynzv4-release
ExecStart=/home/user/querynzv4-release/.venv/bin/python -m checks.board --heartbeat
TimeoutStartSec=300
Environment=PYTHONUNBUFFERED=1
