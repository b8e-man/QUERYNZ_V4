#!/usr/bin/env python3
"""The merge gate (plan: "Merging", "Two tiers of checks").

  bin/merge-gate <branch> [--no-merge] [--repo PATH]

One command: it checks the branch out into a gate working copy, runs every
test there (the one-way import test among them), and refuses on any
failure. On a pass it merges the branch into main in the main checkout with
a merge commit; with --no-merge it only reports. The run's output is kept
at <work>/gate/<branch>.log. Exit 0 = merged (or would merge), 1 = refused.

The full tier at a merge (1b.7, ruling 113): the fast tier for the whole
repository (every test not marked slow: the contract tests, the one-way
import test, the spec and reading-limit checks), then the slow tests of the
modules the branch touches and of the modules that read what they publish
(a change to a lane's publish.sql, pane.md, tables.sql, spec.md or profiles
runs the slow tests of links/, checks/ and products/), then the staging
load of the touched modules that carry a load.py (support/staging). A
branch touching support/, bin/, .claude/, the root tests, the plan or the
test configuration runs every slow test, because everything imports or runs
through those. It must be run from a clean main checkout on the main
branch. Stdlib only."""
import os
import re
import shutil
import subprocess
import sys

WORK = os.environ.get("QV4_WORK") or "/home/user/querynzv4-work"
ROOTS = ("keys", "support", "registers", "links", "products", "checks")
#: a change here runs every slow test: everything imports or runs through these
WHOLE = ("bin/", ".claude/", "tests/", "docs/plan/", "support/", "pytest.ini", "conftest.py", "pyproject.toml")
#: a module's contract with its readers: changing one runs the readers' slow tests too
CONTRACT = ("publish.sql", "pane.md", "tables.sql", "spec.md", "profile-proposed.jsonl")
READERS = ("links", "checks", "products")


def module_of(path: str):
    parts = path.split("/")
    if parts[0] not in ROOTS:
        return None
    if parts[0] in ("keys", "links"):
        return parts[0]
    return "/".join(parts[:2]) if len(parts) > 2 else None


def slow_targets(repo: str, branch: str, base: str = "main"):
    """Where the slow tests run (ruling 113): None means the whole
    repository; a list names the folders; an empty list means no slow test
    applies (the branch touched no module and nothing everything depends on)."""
    files = git(repo, "diff", "--name-only", f"{base}...{branch}").split("\n")
    touched, contract = set(), False
    for f in (x.strip() for x in files if x.strip()):
        if f.startswith(WHOLE) or f in WHOLE:
            return None
        m = module_of(f)
        if m:
            touched.add(m)
            if os.path.basename(f) in CONTRACT:
                contract = True
    targets = sorted(touched)
    if contract:
        targets += [r for r in READERS if os.path.isdir(os.path.join(repo, r)) and r not in targets]
    return [t for t in targets if not any(t != o and t.startswith(o + "/") for o in targets)]


def die(msg: str) -> None:
    print(f"merge-gate: {msg}", file=sys.stderr)
    sys.exit(1)


def git(repo, *args, check=True) -> str:
    p = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)
    if check and p.returncode:
        die(f"git {' '.join(args)}: {p.stderr.strip()}")
    return p.stdout.strip()


def python_for(repo: str) -> str:
    venv = os.path.join(repo, ".venv", "bin", "python")
    return venv if os.path.exists(venv) else sys.executable


def load_touched(repo: str, branch: str, gate_dir: str):
    """The full tier's loading step (1b.7): the modules the branch touches
    that carry a load.py go into a staging schema of the real database and
    are published on success. It runs INSIDE the gate's working copy, so
    the branch's own loader is the code that loads (the main checkout does
    not have it yet). Skipped, saying so, where the repository's
    environment or the owner's credential file is absent. Returns the
    completed process, or None when skipped."""
    py = os.path.join(repo, ".venv", "bin", "python")
    cred_dir = os.environ.get("QV4_CRED_DIR") or os.path.join(os.path.expanduser("~"), ".querynz")
    if not os.path.exists(py) or not os.path.exists(os.path.join(cred_dir, "v4.env")) or os.environ.get("QV4_NO_DB"):
        return None
    return subprocess.run([py, "-m", "support.staging", branch], cwd=gate_dir, capture_output=True, text=True,
                          env={**os.environ, "CLAUDE_PROJECT_DIR": gate_dir})


def main() -> int:
    args = sys.argv[1:]
    repo = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if "--repo" in args:
        i = args.index("--repo")
        repo = os.path.abspath(args[i + 1])
        del args[i:i + 2]
    merge = "--no-merge" not in args
    args = [a for a in args if a != "--no-merge"]
    if len(args) != 1:
        die("usage: bin/merge-gate <branch> [--no-merge] [--repo PATH]")
    branch = args[0]
    if not git(repo, "rev-parse", "--verify", "--quiet", branch, check=False):
        die(f"no branch {branch}")
    if merge:
        if git(repo, "rev-parse", "--abbrev-ref", "HEAD") != "main":
            die("the main checkout must be on main to merge")
        if git(repo, "status", "--porcelain", "--untracked-files=no"):
            die("the main checkout has uncommitted changes")
    slug = re.sub(r"[^a-zA-Z0-9]+", "-", branch).strip("-")
    gate_dir = os.path.join(WORK, "gate", slug)
    log = gate_dir + ".log"
    os.makedirs(os.path.dirname(gate_dir), exist_ok=True)
    if os.path.exists(gate_dir):
        git(repo, "worktree", "remove", "--force", gate_dir, check=False)
        shutil.rmtree(gate_dir, ignore_errors=True)
    git(repo, "worktree", "add", "--detach", gate_dir, branch)
    staging = None
    try:
        env = {**os.environ, "CLAUDE_PROJECT_DIR": gate_dir}
        py = python_for(repo)
        p = subprocess.run([py, "-m", "pytest", "-p", "no:cacheprovider", "-q", "-m", "not slow"],
                           cwd=gate_dir, capture_output=True, text=True, env=env)
        with open(log, "w", encoding="utf-8") as f:
            f.write("--- fast tier, whole repository ---\n" + p.stdout + p.stderr)
        if p.returncode == 0:
            targets = slow_targets(repo, branch)
            where = "the whole repository" if targets is None else (", ".join(targets) or "nothing: no module touched")
            if targets is None or targets:
                p = subprocess.run([py, "-m", "pytest", "-p", "no:cacheprovider", "-q", "-m", "slow", *(targets or [])],
                                   cwd=gate_dir, capture_output=True, text=True, env=env)
                if p.returncode == 5:                      # no slow test collected there: nothing to refuse on
                    p.returncode = 0
            with open(log, "a", encoding="utf-8") as f:
                f.write(f"\n--- slow tests: {where} ---\n" + p.stdout + p.stderr)
        if p.returncode == 0:
            staging = load_touched(repo, branch, gate_dir)
            if staging is not None:
                with open(log, "a", encoding="utf-8") as f:
                    f.write("\n--- staging ---\n" + staging.stdout + staging.stderr)
    finally:
        git(repo, "worktree", "remove", "--force", gate_dir, check=False)
        git(repo, "worktree", "prune", check=False)
    tail = "\n".join((p.stdout + p.stderr).strip().split("\n")[-15:])
    if p.returncode:
        print(f"REFUSED {branch}: tests failed (full output: {log})\n{tail}")
        return 1
    if staging is not None and staging.returncode:
        print(f"REFUSED {branch}: tests passed but the staging load failed\n{staging.stdout[-1500:]}{staging.stderr[-1500:]}")
        return 1
    note = (staging.stdout or "").strip() if staging is not None else "staging: skipped (no database environment here)"
    if not merge:
        print(f"GREEN {branch}: every test passed; not merged (--no-merge)\n{tail}\n{note}")
        return 0
    git(repo, "merge", "--no-ff", "--no-edit", "-m", f"merge {branch}: gate green", branch)
    print(f"MERGED {branch} into main: every test passed\n{tail}\n{note}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
