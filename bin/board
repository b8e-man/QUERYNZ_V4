#!/usr/bin/env python3
"""The card board, generated from cards/ (plan: "Cards"). Nobody edits it.

  bin/board [--repo PATH]   writes docs/board.md and docs/parking.md

A card is one file cards/<name>.md:

  # <title>
  kind: blocker | finding | idea
  state: open | closed | accepted | dropped
  use-case: <number or ->
  session: <who raised it>
  opened: <date>
  closed: <date or blank>

  <what it is; what was done>

Blockers and findings go on the board, open first. Ideas go to the parking
list. A finding that is accepted leaves the board for the product's
known-limits page, so the board shows accepted and dropped cards only as a
count. Exit 1 on a card the board cannot read."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _records import read_folder, write_if_changed  # noqa: E402

KINDS = ("blocker", "finding", "idea")
STATES = ("open", "closed", "accepted", "dropped")
REQUIRED = ("kind", "state", "session", "opened")


def check(card: dict) -> None:
    f = card["fields"]
    for k in REQUIRED:
        if k not in f:
            raise ValueError(f"{card['path']}: missing `{k}:`")
    if f["kind"] not in KINDS:
        raise ValueError(f"{card['path']}: kind must be one of {KINDS}")
    if f["state"] not in STATES:
        raise ValueError(f"{card['path']}: state must be one of {STATES}")
    if f["state"] != "open" and not f.get("closed"):
        raise ValueError(f"{card['path']}: a card that is not open needs `closed: <date>`")


def row(c: dict) -> str:
    f = c["fields"]
    return f"| [{c['name']}](../cards/{c['name']}.md) | {c['title']} | {f.get('use-case', '-')} | {f['session']} | {f['opened']} |"


def render(cards: list) -> tuple:
    for c in cards:
        check(c)
    open_b = [c for c in cards if c["fields"]["kind"] == "blocker" and c["fields"]["state"] == "open"]
    open_f = [c for c in cards if c["fields"]["kind"] == "finding" and c["fields"]["state"] == "open"]
    closed = [c for c in cards if c["fields"]["kind"] != "idea" and c["fields"]["state"] != "open"]
    ideas = [c for c in cards if c["fields"]["kind"] == "idea"]
    hdr = "| Card | What | Use case | Raised by | Opened |\n| --- | --- | --- | --- | --- |"
    out = ["# Card board", "", "Generated by `bin/board` from `cards/`. Do not edit.", "",
           f"## Blockers open: {len(open_b)}", ""]
    out += [hdr] + [row(c) for c in open_b] if open_b else ["None."]
    out += ["", f"## Findings open: {len(open_f)}", ""]
    out += [hdr] + [row(c) for c in sorted(open_f, key=lambda c: (c["fields"].get("use-case", "-"), c["name"]))] if open_f else ["None."]
    counts = {s: sum(1 for c in closed if c["fields"]["state"] == s) for s in ("closed", "accepted", "dropped")}
    out += ["", "## Off the board", "",
            f"Closed {counts['closed']} · accepted onto a known-limits page {counts['accepted']} · dropped {counts['dropped']}", ""]
    park = ["# Parking list", "", "Ideas, generated by `bin/board` from `cards/`. Not on the board. Do not edit.", ""]
    park += [f"- [{c['name']}](../cards/{c['name']}.md): {c['title']} ({c['fields']['session']}, {c['fields']['opened']})"
             for c in ideas] or ["None."]
    return "\n".join(out) + "\n", "\n".join(park) + "\n"


def main() -> int:
    args = sys.argv[1:]
    repo = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if "--repo" in args:
        repo = os.path.abspath(args[args.index("--repo") + 1])
    try:
        board, park = render(read_folder(os.path.join(repo, "cards")))
    except ValueError as e:
        print(f"board: {e}", file=sys.stderr)
        return 1
    a = write_if_changed(os.path.join(repo, "docs", "board.md"), board)
    b = write_if_changed(os.path.join(repo, "docs", "parking.md"), park)
    print("board: " + ("written" if a or b else "unchanged"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
