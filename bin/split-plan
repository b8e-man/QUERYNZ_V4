#!/usr/bin/env python3
"""Split the plan into the files "What to read, and how much" lays out
(plan step 1.1). It changes no words.

  bin/split-plan [--source docs/PLAN.md] [--out docs/plan] [--commit SHA]

The TABLE below names every heading of the plan, in order, and the file it
goes to. The script walks the document and refuses a heading it does not
know or one out of order. A piece is a heading line and everything up to
the next heading; the title lines above the first heading are the first
piece and go to the index. A second-level heading and the text under it
before the first third-level heading go with the first piece of that
section — in the reference folders, to a file named 00-intro.md. The two
diagram placeholders stay where they are. Files are the concatenation of
their pieces in document order, which is not always adjacent in the
document (core.md, map.md).

It writes <out>/manifest.json — the source commit and, in document order,
each piece's file and line count — so the original can be rejoined exactly
(tests/test_plan_split.py does), and <out>/headings.md: every heading and
step number with its file. The index is written over the source file when
--out is the repository's docs/plan. Stdlib only."""
import hashlib
import json
import os
import re
import subprocess
import sys

INDEX = "PLAN.md"          # written beside docs/plan/, as docs/PLAN.md
R1 = "reference/old-estate/"
R2 = "reference/registers-and-use-cases/"
R3 = "reference/facts-and-traps/"
R4 = "reference/dated-jobs-open-decisions-rulings/"

# (level, heading text, file). "" for the level marks the title piece.
TABLE = [
    ("", "", INDEX),
    ("##", "Read this first", "core.md"),
    ("###", "Who you are", "core.md"),
    ("###", "What to read, and how much", INDEX),
