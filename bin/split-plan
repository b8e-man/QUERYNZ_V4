    ("###", "Rulings in force from the October discussion", R4 + "rulings-in-force-from-the-october-discussion.md"),
    ("###", "What this changes in the old terminal document", R4 + "what-this-changes-in-the-old-terminal-document.md"),
    ("###", "Notes from Arthur, 16 October 2026", R4 + "notes-from-arthur-16-october-2026.md"),
    ("###", "Notes from Arthur, 17 October 2026", R4 + "notes-from-arthur-17-october-2026.md"),
    ("###", "The later list", R4 + "the-later-list.md"),
]
HEADING = re.compile(r"^(#{2,3}) (.*?)\s*$")
STEP_NUMBER = re.compile(r"^\*\*((?:\d+[ab]?\.\d+)|(?:[A-H]\.\d+))\b")


def split(text: str) -> list:
    """[(file, heading, [lines])] in document order; every line of the
    source in exactly one piece."""
    lines = text.splitlines(keepends=True)
    pieces = []
    cur = []
    expect = 0
    file = TABLE[0][2]
    heading = ""
    for ln in lines:
        m = HEADING.match(ln)
        if m:
            pieces.append((file, heading, cur))
            expect += 1
            if expect >= len(TABLE):
                raise SystemExit(f"split-plan: heading not in the table: {ln.strip()!r}")
            level, want, file = TABLE[expect]
            if (m.group(1), m.group(2)) != (level, want):
                raise SystemExit(f"split-plan: expected {level} {want!r}, found {ln.strip()!r}")
            heading = ln.strip()
            cur = [ln]
        else:
            cur.append(ln)
    pieces.append((file, heading, cur))
    if expect != len(TABLE) - 1:
        raise SystemExit(f"split-plan: the document ended after {expect + 1} of {len(TABLE)} headings")
    return pieces


def rejoin(manifest: dict, read) -> str:
    """The original from the pieces: `read(file)` gives a file's text."""
    cursors: dict = {}
    out = []
    for p in manifest["pieces"]:
        lines = cursors.setdefault(p["file"], read(p["file"]).splitlines(keepends=True))
        n = p["lines"]
        out.extend(lines[:n])
        cursors[p["file"]] = lines[n:]
    return "".join(out)


def headings_md(pieces: list) -> str:
    out = ["# Every heading and step number of the plan, with its file", "",
           "Generated by `bin/split-plan`. Search it to follow a cross-reference such as \"see step 1.10\".", ""]
    for file, heading, body in pieces:
        if heading:
            out.append(f"- {heading} → `{file}`")
        for ln in body:
            m = STEP_NUMBER.match(ln)
            if m:
                out.append(f"    - {m.group(1)} → `{file}`")
    return "\n".join(out) + "\n"


def main() -> int:
    args = sys.argv[1:]
    repo = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    source = os.path.join(repo, "docs", "PLAN.md")
    out = os.path.join(repo, "docs", "plan")
    commit = ""
    i = 0
    while i < len(args):
        if args[i] == "--source":
            source = os.path.abspath(args[i + 1]); i += 2
        elif args[i] == "--out":
            out = os.path.abspath(args[i + 1]); i += 2
        elif args[i] == "--commit":
            commit = args[i + 1]; i += 2
        else:
            raise SystemExit("usage: bin/split-plan [--source FILE] [--out DIR] [--commit SHA]")
    text = open(source, encoding="utf-8").read()
    if not commit:
        dirty = subprocess.run(["git", "status", "--porcelain", "--", source], cwd=repo, capture_output=True, text=True).stdout
        if dirty.strip():
            raise SystemExit("split-plan: commit the source first, so the manifest can name the commit it was split from")
        commit = subprocess.run(["git", "rev-parse", "HEAD"], cwd=repo, capture_output=True, text=True).stdout.strip()
    pieces = split(text)
    files: dict = {}
    for file, heading, body in pieces:
        files.setdefault(file, []).extend(body)
    for file, body in files.items():
        path = os.path.join(os.path.dirname(out), file) if file == INDEX else os.path.join(out, file)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write("".join(body))
    manifest = {"source_commit": commit, "source_path": os.path.relpath(source, repo),
                "source_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
                "pieces": [{"file": f, "heading": h, "lines": len(b)} for f, h, b in pieces]}
    with open(os.path.join(out, "manifest.json"), "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=1)
        f.write("\n")
    with open(os.path.join(out, "headings.md"), "w", encoding="utf-8") as f:
        f.write(headings_md(pieces))
    print(f"split-plan: {len(pieces)} pieces into {len(files)} files under {out}; source {commit[:9]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
