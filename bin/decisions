#!/usr/bin/env python3
"""The decision queue, generated from docs/decisions/queue/ (plan: "The
decision queue and the rulings"). Nobody edits it; answers go in
docs/decisions/rulings.md, numbered on from 55, and the integrator then
removes the question's file.

  bin/decisions [--repo PATH]   writes docs/decisions/queue.md

A question is one file docs/decisions/queue/<name>.md, so parallel sessions
never edit the same file:

  # <the question>
  default: <what is built until he rules, or `none`>
  blocks: <what waits on the answer, or `nothing`>
  recommendation: <yours, with the reason>
  raised: <date> by <session>

  <more, if needed>

A question with no default stops the work it blocks; everything else goes
ahead on its default."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _records import read_folder, write_if_changed  # noqa: E402

REQUIRED = ("default", "blocks", "recommendation", "raised")


def check(q: dict) -> None:
    for k in REQUIRED:
        if k not in q["fields"]:
            raise ValueError(f"{q['path']}: missing `{k}:`")


def render(qs: list) -> str:
    for q in qs:
        check(q)
    no_default = [q for q in qs if q["fields"]["default"].lower() in ("none", "no default")]
    rest = [q for q in qs if q not in no_default]
    out = ["# Decisions waiting on Arthur", "",
           "Generated by `bin/decisions` from `docs/decisions/queue/`. Do not edit. Answers go in `rulings.md`.", ""]

    def table(rows):
        t = ["| Question | Default, used until he rules | Blocks | Recommendation | Raised |",
             "| --- | --- | --- | --- | --- |"]
        for q in rows:
            f = q["fields"]
            t.append(f"| [{q['title']}](queue/{q['name']}.md) | {f['default']} | {f['blocks']} | {f['recommendation']} | {f['raised']} |")
        return t
    out += [f"## No default: {len(no_default)}. These stop what they block.", ""]
    out += table(no_default) if no_default else ["None."]
    out += ["", f"## With a default: {len(rest)}. The build goes ahead on the default.", ""]
    out += table(rest) if rest else ["None."]
    return "\n".join(out) + "\n"


def main() -> int:
    args = sys.argv[1:]
    repo = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if "--repo" in args:
        repo = os.path.abspath(args[args.index("--repo") + 1])
    try:
        text = render(read_folder(os.path.join(repo, "docs", "decisions", "queue")))
    except ValueError as e:
        print(f"decisions: {e}", file=sys.stderr)
        return 1
    changed = write_if_changed(os.path.join(repo, "docs", "decisions", "queue.md"), text)
    print("decisions: " + ("written" if changed else "unchanged"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
