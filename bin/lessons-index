#!/usr/bin/env python3
"""The lessons index, generated from lessons/ (plan: "Lessons"). Nobody
edits it.

  bin/lessons-index [--repo PATH]   writes lessons/INDEX.md

A lesson is one file lessons/<name>.md whose FIRST LINE is the rule in one
sentence, because that line is what the search shows:

  <The rule, one sentence.>
  area: <where it bites: fences, hooks, scheduler, …; comma-separated>
  paid-for-by: <the date, card or incident>

  <why; what it cost>

The index is one line per lesson: the rule, the area, the file. The old
estate's one-line index joins it under reference/ in step 1.7, and the
search of step 1b reads both. Exit 1 on a lesson with no rule or no area."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _records import read_folder, write_if_changed  # noqa: E402


def check(lesson: dict) -> None:
    with open(lesson["path"], encoding="utf-8") as f:
        first = f.readline().strip()
    if not first or first.startswith("#"):
        raise ValueError(f"{lesson['path']}: the first line must be the rule in one sentence, not a heading")
    if len(lesson["title"]) > 240:
        raise ValueError(f"{lesson['path']}: the rule is {len(lesson['title'])} characters; one sentence")
    if not lesson["fields"].get("area"):
        raise ValueError(f"{lesson['path']}: missing `area:`")


def render(lessons: list) -> str:
    for l in lessons:
        check(l)
    out = ["# Lessons index", "", "Generated by `bin/lessons-index` from `lessons/`. One line per lesson: the rule, "
           "its area, its file. Do not edit.", ""]
    out += [f"- {l['title']} — `{l['name']}.md` ({l['fields']['area']})" for l in lessons] or ["None yet."]
    return "\n".join(out) + "\n"


def main() -> int:
    args = sys.argv[1:]
    repo = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if "--repo" in args:
        repo = os.path.abspath(args[args.index("--repo") + 1])
    try:
        text = render(read_folder(os.path.join(repo, "lessons")))
    except ValueError as e:
        print(f"lessons-index: {e}", file=sys.stderr)
        return 1
    changed = write_if_changed(os.path.join(repo, "lessons", "INDEX.md"), text)
    print("lessons-index: " + ("written" if changed else "unchanged"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
