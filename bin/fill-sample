#!/home/user/querynzv4/.venv/bin/python
"""Fill a named scratch schema of the sample database from every module's
sample.list, through the code of this working copy (plan 1b.6).

  bin/fill-sample <schema>          e.g. scratch_fix-keys-1, or pub for the integrator's own fill
  bin/fill-sample --session         the schema for this working copy's session, from .scope
  bin/fill-sample --list            just list the modules and their item counts

Runs with the repository's own environment (psycopg). Stdlib otherwise."""
import os
import sys

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, HERE)
sys.path.insert(0, os.path.join(HERE, "bin"))
import _session as S  # noqa: E402
from support import db, sample  # noqa: E402


def main() -> int:
    args = sys.argv[1:]
    if args == ["--list"]:
        for module, items in sample.lists(HERE):
            print(f"{module}: {len(items)} item(s)")
        return 0
    if args == ["--session"]:
        scope = S.read_scope(os.path.join(HERE, ".scope"))
        if not scope.get("name"):
            S.die("fill-sample", "no scope file here; name the schema instead")
        schema = sample.scratch_name(scope["name"])
    elif len(args) == 1 and not args[0].startswith("-"):
        schema = args[0]
    else:
        S.die("fill-sample", "usage: bin/fill-sample <schema> | --session | --list")
    sample.fill_schema(schema, lambda: db.connect(db.OWNER_KEY, "querynz_v4_sample"), HERE)
    return 0


if __name__ == "__main__":
    sys.exit(main())
