+# THE TRIAL'S JOB TYPES (plan steps 3.5 to 3.7), appended to
+# support/scheduler/jobs.toml by the integrator (the merge request carries
+# the patch). One bulk job type per reader, cut into pieces of one document
+# each (rule 7: a worker stopped mid-run loses at most one piece); a small
+# `waiting`-class job to inject part-way (3.6: a small job never waits for
+# ever); and the text-reader pass that turns each reader's page text into
+# rows for scoring (3.7). memory_gb is per piece, the child process only
+# (the model server is the card manager's). Priorities 40 to 52 are the
+# trial's; the pass-one job (GLM-OCR) goes first.
+
+[jobs.qv4-trial-read-glm-ocr]
+description = "Step 3: one page-set document, every selected page rendered and read by the incumbent GLM-OCR (profile page-reader); pass one reproduces the old estate's readings by hash and page."
+needs = "model-profile"
+profile = "page-reader"
+memory_gb = 1.5
+deadline_s = 3600
+query_timeout_s = 60
+class = "whenever"
+priority = 40
+command = ["python", "-m", "support.trials", "piece"]
+requires = ["pdftoppm"]
+pieces = true
+can_share = false
+concurrency = 1
+
+[jobs.qv4-trial-read-glm-ocr-f16]
