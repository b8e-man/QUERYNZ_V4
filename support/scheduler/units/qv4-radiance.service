[Unit]
Description=QueryNZV4 model server — Qwen 3.8 27B, one Radiance server a card behind one address, 127.0.0.1:8060
# The estate's text-reader and review model on both boxes (profiles.toml, profile qwen38-27b; Arthur, 26 November
# 2026: "let's switch everything to 3.8 27b"). This unit is the proxy (support/scheduler/fanout.py) on the port the
# standing server has always had; the servers are qv4-radiance-card@0 (:8070) and qv4-radiance-card@1 (:8071), and
# are part of this unit: starting it starts both, stopping or restarting it stops or restarts both. The card manager
# reads the model back through it and records the load; it stops and starts this unit in the night window of
# jobs.toml [night_window] only (ruling 129); the watchdog reads both servers' counters through it. Until 26 November
# 2026 this unit ran Flash-Next across both cards (ruling 121; the git history of this file).
Requires=qv4-radiance-card@0.service qv4-radiance-card@1.service
After=qv4-radiance-card@0.service qv4-radiance-card@1.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=notify
WorkingDirectory=/home/user/querynzv4-release
ExecStart=/home/user/querynzv4-release/.venv/bin/python -m support.scheduler.fanout --port 8060 --backends http://127.0.0.1:8070,http://127.0.0.1:8071
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=300
TimeoutStopSec=60
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
