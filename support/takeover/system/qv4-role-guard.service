[Unit]
Description=QueryNZV4 role guard: a box whose floating address is held elsewhere boots not-primary (track A lesson 3)
After=NetworkManager.service
Before=postgresql.service querynz-vip.service querynz-vip-bridge.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/qv4-takeover/role-guard.sh
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
