   "form": "direct",
   "speaker": "e6",
   "speaker_as_printed": "He",
   "verb": "said",
   "channel": "interview",
   "about": [
    "e1"
   ]
  },
  {
   "text": "it was just another example of the National Party lying to the New Zealand public",
