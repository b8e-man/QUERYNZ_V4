   "speaker": "e5",
   "speaker_as_printed": "Prime Minister Christopher Luxon",
   "verb": "said",
   "channel": "interview",
   "about": []
  },
  {
   "text": "desperate",
   "form": "partial",
   "speaker": "e6",
   "speaker_as_printed": "Kieran McAnulty",
   "verb": "said",
   "channel": "interview",
   "about": [
    "e1"
   ]
  },
  {
   "text": "They are desperately worried ... and they are trying desperate measures.",
   "form": "direct",
   "speaker": "e6",
   "speaker_as_printed": "Kieran McAnulty",
   "verb": "said",
   "channel": "interview",
   "about": [
    "e1"
   ]
  },
  {
   "text": "I'm not sure it'll wash with New Zealanders. I'm not sure it'll sit that comfortably with them.",
   "form": "direct",
   "speaker": "e6",
   "speaker_as_printed": "Kieran McAnulty",
   "verb": "said",
   "channel": "interview",
   "about": [
    "e1"
   ]
  },
  {
   "text": "we're going to be dealing with a dishonest campaign now",
   "form": "partial",
   "speaker": "e6",
