 "descriptors": [],
 "quotes": [
  {"text": "We f***ed up,", "form": "direct", "speaker": "e3", "speaker_as_printed": "Team 18 team principal Adrian Burgess", "verb": "said", "channel": "interview", "about": ["e2"]},
  {"text": "We were f***ed already. We knew we were,", "form": "direct", "speaker": "e3", "speaker_as_printed": "Burgess", "verb": "said", "channel": "interview", "about": ["e2"]},
  {"text": "Once I knew how much fuel short we were, I knew we were cooked,", "form": "direct", "speaker": "e1", "speaker_as_printed": "De Pasquale", "verb": "said", "channel": "interview", "about": ["e2"]},
  {"text": "We've had an error somewhere in the fuel calculations. It's pretty clear. There's no point glossing over it,", "form": "direct", "speaker": "e3", "speaker_as_printed": "Burgess", "verb": "said", "channel": "interview", "about": ["e2"]},
  {"text": "We probably had a bigger gap than we thought we had.", "form": "direct", "speaker": "e3", "speaker_as_printed": "Burgess", "verb": "said", "channel": "interview", "about": []},
  {"text": "You think, 'Shit, I should've sat in the pit lane for another two seconds' and we wouldn't be having this conversation.", "form": "direct", "speaker": "e3", "speaker_as_printed": "Burgess", "verb": "said", "channel": "interview", "about": []},
  {"text": "But that's hindsight and I don't have that crystal ball.", "form": "direct", "speaker": "e3", "speaker_as_printed": "Burgess", "verb": "said", "channel": "interview", "about": []},
  {"text": "If it [the safety car] had gone one more lap longer, we probably would've got home,", "form": "direct", "speaker": "e3", "speaker_as_printed": "Burgess", "verb": "said", "channel": "interview", "about": []},
  {"text": "But we shouldn't have been in that position in the first place because we had the tools, we had the car, we had the drivers.", "form": "direct", "speaker": "e3", "speaker_as_printed": "Burgess", "verb": "said", "channel": "interview", "about": ["e2"]},
  {"text": "We've had a f**k-up. It's not acceptable... but this is the mountain.", "form": "direct", "speaker": "e3", "speaker_as_printed": "Burgess", "verb": "said", "channel": "interview", "about": ["e2"]},
  {"text": "Ah, I can't explain it.", "form": "direct", "speaker": "e3", "speaker_as_printed": "Burgess", "verb": "said", "channel": "interview", "about": []}
 ],
