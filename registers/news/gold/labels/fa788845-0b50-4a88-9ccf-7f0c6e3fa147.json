 "descriptors": [{"who": "e1", "text": "Australian citizen"}, {"who": "e1", "text": "36"}, {"who": "e2", "text": "Chinese national"}, {"who": "e2", "text": "33"}, {"who": "e2", "text": "owned a beauty salon after graduating from a school in Australia"}],
 "quotes": [
  {"text": "Do you mean in the sense that we don't know what's in them?", "form": "direct", "speaker": "e3", "speaker_as_printed": "the judge", "verb": "asked", "channel": "court", "about": []},
  {"text": "Yes, sir, given that they are largely counterfeit cigarettes,", "form": "direct", "speaker": "e4", "speaker_as_printed": "she", "verb": "replied", "channel": "court", "about": []},
  {"text": "You need to work hard yourself,", "form": "direct", "speaker": "e1", "speaker_as_printed": "he", "verb": "told", "channel": "social", "about": ["e8"]},
  {"text": "I consider you a brother, don't disappoint me anymore. Earn money together.", "form": "direct", "speaker": "e1", "speaker_as_printed": "he", "verb": "told", "channel": "social", "about": ["e8"]},
  {"text": "All the address are addresses for rent that my rental agent friend rented,", "form": "direct", "speaker": "e1", "speaker_as_printed": "he", "verb": "told", "channel": "social", "about": ["e19"]},
  {"text": "Difference being some of the houses got rented out and some haven't yet.", "form": "direct", "speaker": "e1", "speaker_as_printed": "he", "verb": "told", "channel": "social", "about": []},
  {"text": "It's been inspected again, feels very light, the stuff got taken out", "form": "direct", "speaker": null, "speaker_as_printed": "a male voice in Mandarin", "verb": "saying", "channel": "social", "about": []},
  {"text": "There are other ways for making money.", "form": "direct", "speaker": "e4", "speaker_as_printed": "She", "verb": "submitted", "channel": "court", "about": ["e1"]},
  {"text": "while her client accepted responsibility for what she had done, she was only doing what her husband told her to do out of a desire to reduce his financial stress", "form": "indirect", "speaker": "e5", "speaker_as_printed": "Tang's lawyer, Skye Lan", "verb": "explained", "channel": "court", "about": ["e2", "e1"]},
  {"text": "clearly commercial", "form": "partial", "speaker": "e4", "speaker_as_printed": "Lin", "verb": "said", "channel": "court", "about": ["e1"]},
  {"text": "There's also a concern that we don't know what's in them, is there not?", "form": "direct", "speaker": "e3", "speaker_as_printed": "Judge Andrée Wiltens", "verb": "asked", "channel": "court", "about": []},
  {"text": "hearsay", "form": "partial", "speaker": "e6", "speaker_as_printed": "Zhu's lawyer Michael Kan", "verb": "calling", "channel": "court", "about": []},
  {"text": "There have been more serious cases in New Zealand but not many.", "form": "direct", "speaker": "e3", "speaker_as_printed": "Judge Wiltens", "verb": "said", "channel": "court", "about": []},
  {"text": "You came to New Zealand especially to carry out this illegal act... you can't do that and then say 'oh I'm really sorry' afterwards. The court can't accept that.", "form": "direct", "speaker": "e3", "speaker_as_printed": "He", "verb": "said", "channel": "court", "about": ["e1", "e2"]},
  {"text": "Overseas nationals need to understand that if they come to New Zealand with the express purpose of committing crime they go to jail,", "form": "direct", "speaker": "e3", "speaker_as_printed": "the judge", "verb": "said", "channel": "court", "about": []},
  {"text": "Tell everybody you know back in China not to come to New Zealand to commit offences.", "form": "direct", "speaker": "e3", "speaker_as_printed": "the judge", "verb": "said", "channel": "court", "about": ["e1", "e2"]}
