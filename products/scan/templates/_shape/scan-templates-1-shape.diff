+def _offers(h: str, here: str, number: tuple) -> str:
+    """What a row here offers a name step: (route, key) per route."""
+    out = [f"('name', {fold_sql(f'{h}.{here}')})"]
+    if number:
+        out.insert(0, f"('number', nullif({h}.{number[0]}::text, ''))")
