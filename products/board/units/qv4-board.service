[Unit]
Description=QueryNZV4 board — one search across every register, panes left to right (plan step 4.9); the local network only
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/querynzv4
ExecStart=/home/user/querynzv4/.venv/bin/python -m products.board serve
# the port and where pins and saved paths live; the credential files are read at the moment of use
Environment=PYTHONUNBUFFERED=1 QV4_BOARD_PORT=8420 QV4_BOARD_BIND=0.0.0.0 QV4_BOARD_STATE=querynz_v4/board
# a standing service: back within ten seconds of a failure; every statement it runs has its own 20 s limit
Restart=on-failure
RestartSec=10
Nice=5

[Install]
WantedBy=default.target
