[Unit]
Description=QueryNZV4 board — one search across every register, panes left to right (plan step 4.9); the local network only
After=network-online.target

[Service]
Type=simple
# the release copy (release-copy-1): one pushed commit of origin/main, moved only by `python -m support.installer release`
WorkingDirectory=/home/user/querynzv4-release
ExecStart=/home/user/querynzv4-release/.venv/bin/python -m products.board serve
# the port, where pins and saved paths live, the subject report every pane links to, the scan and site preview the use cases tab opens (ruling 89), and the chat pane's model (ruling 122: Flash-Next on Radiance, ruling 121); the credential files are read at the moment of use
Environment=PYTHONUNBUFFERED=1 QV4_BOARD_PORT=8420 QV4_BOARD_BIND=0.0.0.0 QV4_BOARD_STATE=querynz_v4/board QV4_REPORT_URL=http://10.0.0.2:8440 QV4_SCAN_URL=http://10.0.0.2:8450 QV4_SITE_URL=http://10.0.0.2:8430 QV4_CHAT_URL=http://127.0.0.1:8060/v1/chat/completions QV4_CHAT_MODEL=qwen4exp
# a standing service: back within ten seconds of a failure; every statement it runs has its own 20 s limit
Restart=on-failure
RestartSec=10
Nice=5

[Install]
WantedBy=default.target
