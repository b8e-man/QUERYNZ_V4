      "Bash(awk *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(xargs *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(ln *)",
      "Bash(chmod *)",
      "Bash(touch *)",
      "Bash(tee *)",
      "Bash(timeout *)",
      "Bash(time *)",
      "Bash(test *)",
      "Bash(true *)",
      "Bash(for *)",
      "Bash(export *)",
      "Bash(date *)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(ps *)",
      "Bash(free *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(uptime *)",
      "Bash(ss *)",
      "Bash(sha256sum *)",
      "Bash(systemctl --user status *)",
      "Bash(systemctl --user is-active *)",
      "Bash(systemctl --user is-enabled *)",
      "Bash(systemctl --user list-timers *)",
      "Bash(systemctl --user list-units *)",
      "Bash(systemctl --user show *)",
      "Bash(systemctl --user cat *)",
      "Bash(systemctl --user daemon-reload *)",
      "Bash(systemctl --user start qv4-*)",
      "Bash(systemctl --user stop qv4-*)",
      "Bash(systemctl --user restart qv4-*)",
      "Bash(systemctl --user enable qv4-*)",
      "Bash(systemctl --user disable qv4-*)",
      "Bash(systemctl status *)",
      "Bash(systemctl is-active *)",
      "Bash(systemctl list-timers *)",
      "Bash(systemctl show *)",
      "Bash(systemctl cat *)",
      "Bash(journalctl --user *)",
      "Bash(journalctl *)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Bash(systemd-run *)"
    ],
    "deny": [
      "Read(~/.querynz/**)",
      "Read(//home/user/.querynz/**)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-/home/user/querynzv4}/.claude/hooks/safety.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-/home/user/querynzv4}/.claude/hooks/scope.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-/home/user/querynzv4}/.claude/hooks/timer.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-/home/user/querynzv4}/.claude/hooks/timer.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
